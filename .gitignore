# Laravel
laravel/vendor/
laravel/node_modules/
laravel/storage/logs/
laravel/storage/framework/cache/
laravel/storage/framework/sessions/
laravel/storage/framework/views/

# Сгенерированные копии статики. Источник правды — `extracted/`,
# а `laravel/public/site/` создаётся скриптом `node scripts/sync-site.mjs`
# (на VPS — на каждом деплое, локально — `npm run sync`). Хранить дубликат
# в git больше не нужно; подробности — в `docs/DEPLOY.md`.
laravel/public/site/

# `chemistry-banks-bundle.js` собирается тем же sync-site.mjs из 17 файлов
# `chemistry-cat*-source.js` и кладётся одновременно в `extracted/` и в
# `laravel/public/site/`, чтобы локальная разработка через `php artisan serve`
# не упиралась в 404. Источник правды — те же 17 *-source.js, поэтому
# bundle git не отслеживает.
extracted/chemistry-banks-bundle.js

# `laravel/public/admin/` — старая копия админки (без `site/`-префикса),
# которую nginx иногда отдавал статически в обход Laravel-роутов.
# Удалена из git; deploy.yml дополнительно снёс её на VPS, и больше
# источника для неё в репо нет — git не положит её обратно.
laravel/public/admin/

# Legacy mirror — actual content lives in `extracted/uploads/` and is served
# from `laravel/public/site/uploads/` (см. `routes/web.php` и DEPLOY.md).
# Locally on Windows this can be a junction to `extracted/uploads/`, which
# we don't want to track again.
laravel/public/uploads/

